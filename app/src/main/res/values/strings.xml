    <string name="engineering_menu_desc">The dashboard\'s own P-parameters</string>
    <string name="engineering_warning">These write straight into the dashboard\'s memory. There is no apply step and no undo, and most cannot be read back — only shown on the scooter\'s screen. Change one at a time and note what it was.</string>
    <string name="engineering_unsupported">This menu belongs to the ViCont dashboard. The connected scooter does not have it.</string>
