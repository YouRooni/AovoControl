    <string name="not_supported">Not supported</string>
    <string name="module_unsupported">This scooter has no AT command module. Password, name, NFC and voice settings are not available on it.</string>
    <string name="limits_scale_display">A gear limit only holds the scooter back up to what the motor can already do. Set above that, it stops limiting anything and just stretches the speedometer: the same motor speed then shows a bigger number.</string>
    <string name="motor_rpm">Motor speed</string>
    <string name="unit_rpm">rpm</string>
    <string name="p1_title">Screen brightness</string>
    <string name="p1_desc">1 is dimmest, 7 is brightest.</string>
    <string name="p2_title">Kick start</string>
    <string name="p2_desc">On means the scooter will not pull away until you push off. This is the inverse of Zero start in Ride settings.</string>
    <string name="p3_title">Cruise control</string>
    <string name="p3_desc">Holds speed after the throttle is held steady.</string>
    <string name="p4_title">Speed units</string>
    <string name="p4_desc">0 shows km/h, 1 shows mph.</string>
    <string name="p5_title">Auto power-off</string>
    <string name="p5_desc">Minutes of standing still before the scooter switches itself off.</string>
    <string name="p6_title">Brake smoothing</string>
    <string name="p6_desc">How sharply the brake lever acts. 1 is heavily damped, 99 is immediate.</string>
    <string name="p7_title">Throttle smoothing</string>
    <string name="p7_desc">How sharply the throttle acts. 1 is heavily damped, 99 is immediate.</string>
    <string name="p8_title">Eco speed limit</string>
    <string name="p8_desc">Speed cap in Eco, in km/h. Also sets what the speedometer calls full speed in that gear.</string>
    <string name="p9_title">Drive speed limit</string>
    <string name="p9_desc">Speed cap in Drive, in km/h.</string>
    <string name="p10_title">Sport speed limit</string>
    <string name="p10_desc">Speed cap in Sport, in km/h. The same setting as the overall speed limit on the controller screen.</string>
    <string name="p11_title">Gear 4 speed limit</string>
    <string name="p11_desc">Speed cap for the fourth gear, which the dashboard marks with the walking figure.</string>
    <string name="p12_title">Gear 5 speed limit</string>
    <string name="p12_desc">Speed cap for the fifth gear, which shows no indicator at all.</string>
    <string name="p13_title">Motor pole pairs</string>
    <string name="p13_desc">How many magnet pairs the motor has. Changing it changes the real motor speed, not just the reading - but it also makes the reported rpm wrong, so the wheel diameter is the better handle of the two.</string>
    <string name="p14_title">Wheel diameter</string>
    <string name="p14_desc">Wheel size in inches. Changing it changes the real motor speed: a smaller value makes the motor spin faster, and the reported rpm stays honest. The dashboard goes on showing the speed it showed before.</string>
    <string name="p15_title">Speedometer source</string>
    <string name="p15_desc">Where the speedometer takes its reading from. Source 6 is the real speed the controller works out from motor rpm - the most accurate one, with no clipping and no regard for a wrong limit. The default source 0 clips above 35 km/h and reads false once a limit above 32 is set. Source 3 shows error E0, and most other values freeze the display on a fixed number.</string>
    <string name="p16_title">Battery voltage smoothing</string>
    <string name="p16_desc">Damping on the battery voltage reading. The visible effect is unclear.</string>
    <string name="p17_title">Traction cutoff voltage</string>
    <string name="p17_desc">Volts at which the controller stops delivering power, for a ten-cell pack. Scaled by the cell count in P23. Raising it can leave the scooter refusing to move on a healthy battery; lowering it can take cells below their safe floor.</string>
    <string name="p18_title">Current limit</string>
    <string name="p18_desc">Maximum discharge current in amps. Raising it puts more heat through the controller and the motor.</string>
    <string name="p19_title">Tail light on braking</string>
    <string name="p19_desc">0 keeps it lit and brightens under braking, 1 makes it flash.</string>
    <string name="p20_title">Starting torque</string>
    <string name="p20_desc">How hard the motor pulls off the line, and how sensitive the throttle feels.</string>
    <string name="p21_title">Electronic brake strength</string>
    <string name="p21_desc">How hard the motor brakes when the lever is pulled.</string>
    <string name="p22_title">Parking lock</string>
    <string name="p22_desc">Holds the motor so the scooter cannot be ridden away.</string>
    <string name="p23_title">Battery cells in series</string>
    <string name="p23_desc">How many cells the pack has in series. Every voltage setting - the traction cutoff and all five gauge thresholds - is rescaled by this. Setting it above the real pack raises the cutoff and can stop the scooter dead on a full battery.</string>
    <string name="p24_title">Unknown switch</string>
    <string name="p24_desc">Purpose unknown. Takes 0 or 1 and no effect has been found.</string>
    <string name="p25_title">Unknown motor value</string>
    <string name="p25_desc">Purpose unknown. Passed to the motor controller at power-on.</string>
    <string name="p26_title">Unknown motor value</string>
    <string name="p26_desc">Purpose unknown. Passed to the motor controller at power-on.</string>
    <string name="p27_title">Unknown motor value</string>
    <string name="p27_desc">Purpose unknown. Passed to the motor controller at power-on.</string>
    <string name="p28_title">Unknown motor value</string>
    <string name="p28_desc">Purpose unknown. Passed to the motor controller at power-on.</string>
    <string name="p29_title">Gauge threshold, 1 bar</string>
    <string name="p29_desc">Volts at which the battery gauge shows one bar, for a ten-cell pack.</string>
    <string name="p30_title">Gauge threshold, 2 bars</string>
    <string name="p30_desc">Volts at which the battery gauge shows two bars.</string>
    <string name="p31_title">Gauge threshold, 3 bars</string>
